# OpenRouter API key — used for embedding requests (https://openrouter.ai/keys).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Embedding model served through OpenRouter. Keep the default so scores stay
# comparable with the dissertation evaluation results in data/datasets/.
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase service_role key (server-side only — never expose to the frontend).
SUPABASE_KEY=

# Frontend (Vite) — leave unset. In local development Vite proxies /api to
# http://127.0.0.1:8000, and in production the API is served from the same
# Vercel domain under /api. Only set this to point at a separately hosted
# backend.
# VITE_API_URL=
