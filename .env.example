OPENAI_API_KEY=your_openai_api_key_here

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase service_role key (server-side only — never expose to the frontend).
SUPABASE_KEY=

# Frontend (Vite) — base URL of the deployed FastAPI backend.
# Leave unset for local development; defaults to http://127.0.0.1:8000.
# In production set this to the Render backend URL, e.g.
#   VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
